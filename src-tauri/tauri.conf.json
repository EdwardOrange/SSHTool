{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SSH 运维终端",
  "version": "0.1.0",
  "identifier": "com.sshoperations.terminal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SSH 运维终端",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "capabilities": ["main-capability"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "category": "DeveloperTool",
    "shortDescription": "安全的多服务器 SSH 运维终端",
    "longDescription": "提供 SSH 终端、资源监控、防火墙安全变更、SFTP 与端口转发。",
    "windows": {
      "wix": {
        "language": ["zh-CN", "en-US"]
      }
    }
  }
}
